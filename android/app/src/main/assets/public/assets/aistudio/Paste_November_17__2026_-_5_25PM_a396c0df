<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MaKSET CareSync – Clickable Prototype</title>
<style>
:root{--g:#0b5d34;--gl:#e6f3ec;--bg:#eef2ef;--card:#fff;--tx:#14231b;--mu:#66756c;--ln:#d9e2dc;--am:#f6b63c;--aml:#fff3d6;--rd:#c62828;--rdl:#fde4e4;--page:#dfe6e1;--cap:#3d4d43}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#101a14;--card:#18251d;--tx:#eaf3ed;--mu:#9bb0a3;--ln:#2a3b31;--gl:#1b3326;--aml:#3a2f12;--rdl:#3d1b1b;--page:#0a110d;--cap:#b9cbbf;--lgbg:#fff}}
:root[data-theme="dark"]{--bg:#101a14;--card:#18251d;--tx:#eaf3ed;--mu:#9bb0a3;--ln:#2a3b31;--gl:#1b3326;--aml:#3a2f12;--rdl:#3d1b1b;--page:#0a110d;--cap:#b9cbbf}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{background:var(--page);font-family:"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--tx);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px)}
.cap{font-size:13px;color:var(--cap);text-align:center;padding:0 12px}
.jump{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:400px}
.jump button{font-size:12px;border:1px solid var(--ln);background:var(--card);color:var(--tx);border-radius:14px;padding:4px 10px;cursor:pointer}
#phone{width:380px;height:760px;max-height:calc(100vh - 130px);background:var(--bg);border-radius:34px;border:8px solid #111;overflow:hidden;position:relative;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.3)}
@media (max-width:480px){#phone{width:100%;height:100%;max-height:none;border:0;border-radius:0;box-shadow:none}.cap,.jump{display:none}body{gap:0}}
#scr{flex:1;overflow-y:auto;position:relative}
.hd{background:var(--g);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:5}
.hd b{font-size:16px;display:block}.hd small{font-size:12px;opacity:.85}
.hd .bk{font-size:24px;cursor:pointer;width:26px}
.pad{padding:12px}
.card{background:var(--card);border:1px solid var(--ln);border-radius:12px;padding:12px;margin-bottom:10px}
.row{display:flex;align-items:center;gap:10px}.sp{flex:1}
.btn{display:block;width:100%;border:0;border-radius:10px;background:var(--g);color:#fff;font-size:15px;font-weight:600;padding:13px;cursor:pointer;margin:8px 0;text-align:center}
.btn.o{background:var(--card);color:var(--g);border:1.5px solid var(--g)}
.btn.s{padding:9px;font-size:13px}
.btn:active{opacity:.85}
.lbl{font-size:12px;color:var(--mu);margin:10px 0 4px}
input,select,textarea{width:100%;border:1px solid var(--ln);background:var(--card);color:var(--tx);border-radius:8px;padding:11px;font-size:14px;font-family:inherit}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--ln);background:var(--card);border-radius:16px;padding:6px 11px;font-size:13px;cursor:pointer;user-select:none}
.chip.on{background:var(--g);color:#fff;border-color:var(--g)}
.av{width:42px;height:42px;border-radius:50%;background:var(--gl);color:var(--g);display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}
.pill{border-radius:14px;padding:3px 10px;font-size:12px;background:var(--gl);color:var(--g)}
.alert{background:var(--rdl);color:var(--rd);border-radius:8px;padding:9px 11px;font-size:13px;font-weight:600;cursor:pointer}
.sync{background:var(--aml);padding:9px 14px;font-size:13px;display:flex;align-items:center;gap:8px;cursor:pointer}
.dot{width:10px;height:10px;border-radius:50%;background:var(--am)}.dot.on{background:#2e9e5b}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.tile{background:var(--card);border:1px solid var(--ln);border-radius:10px;padding:12px 4px;text-align:center;font-size:12px;cursor:pointer}
.tile i{display:block;font-style:normal;font-size:24px;margin-bottom:4px}
.tile.big{background:var(--g);color:#fff;font-size:14px;font-weight:600;padding:16px}
.li{display:flex;align-items:center;gap:10px;cursor:pointer}.li small{color:var(--mu);font-size:12px;display:block}
.li:after{content:"›";color:var(--mu);font-size:20px;margin-left:auto}
.tabs{display:flex;border-bottom:1px solid var(--ln);margin:10px 0}
.tabs div{flex:1;text-align:center;padding:9px;font-size:14px;color:var(--mu);cursor:pointer}
.tabs .on{color:var(--g);border-bottom:2px solid var(--g);font-weight:600}
.sec{font-weight:700;font-size:14px;margin-bottom:6px;color:var(--g)}
.nav{display:flex;background:var(--card);border-top:1px solid var(--ln);padding:6px 0 4px}
.nav div{flex:1;text-align:center;font-size:11px;color:var(--mu);cursor:pointer}.nav i{display:block;font-style:normal;font-size:19px}.nav .on{color:var(--g);font-weight:700}
#toast{position:absolute;left:14px;right:14px;bottom:70px;background:#14231b;color:#fff;border-radius:10px;padding:11px 14px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:40;text-align:center}
#toast.show{opacity:1}
.splash{background:var(--g);color:#fff;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px;cursor:pointer;position:relative;overflow:hidden}
.stat{font-size:26px;font-weight:700;color:var(--g)}
pre{white-space:pre-wrap;font-family:inherit;font-size:13px;line-height:1.5}
small.m{display:block;color:var(--mu);font-size:12px}
.stb{background:var(--g);color:#fff;font-size:12px;padding:6px 18px 3px;display:flex;justify-content:space-between;flex:none}.stb.lt{background:var(--card);color:var(--tx)}
@media (max-width:480px){.stb{display:none}}
.pf .pill{flex:1;text-align:center;padding:7px}
.bar{display:flex;align-items:flex-end;gap:8px;height:90px;margin-top:6px}.bar div{flex:1;background:var(--g);border-radius:4px 4px 0 0;position:relative;min-height:3px}.bar span{position:absolute;bottom:-17px;left:0;right:0;text-align:center;font-size:10px;color:var(--mu)}
table.t{width:100%;border-collapse:collapse;font-size:12px}.t td,.t th{padding:7px 4px;border-bottom:1px solid var(--ln);text-align:left}.t th{color:var(--mu);font-weight:600}
.up{color:var(--rd);font-weight:700}.wn{color:#b07a00;font-weight:700}
#drw{position:absolute;inset:0;z-index:20;display:none}.dbg{position:absolute;inset:0;background:rgba(0,0,0,.45)}.dpn{position:absolute;top:0;bottom:0;left:0;width:82%;background:var(--card);overflow-y:auto;box-shadow:4px 0 20px rgba(0,0,0,.3)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .lgo{background:#fff;border-radius:14px;padding:6px}}
.blink{animation:bl 1s infinite;border-color:var(--rd)}@keyframes bl{50%{box-shadow:0 0 0 5px rgba(198,40,40,.5)}}
.ring{display:inline-block;animation:rg 1s infinite}@keyframes rg{0%,100%{transform:rotate(0)}20%{transform:rotate(-20deg)}40%{transform:rotate(20deg)}60%{transform:rotate(-12deg)}80%{transform:rotate(12deg)}}
.bdg{position:absolute;top:-6px;right:-8px;background:#e53935;color:#fff;border-radius:9px;min-width:16px;height:16px;font-size:10px;display:flex;align-items:center;justify-content:center;padding:0 3px}
#mdl{position:absolute;inset:0;z-index:30;display:none;background:rgba(0,0,0,.5);align-items:center;padding:16px}.mbx{background:var(--card);border-radius:14px;padding:16px;width:100%}
</style>
</head>
<body>
<div class="cap">MaKSET CareSync clickable prototype. Tap through it. On Home, tap the amber status bar to go online and watch the sync.</div>
<div id="phone">
  <div class="stb" id="stb"><b>9:41</b><span>▾ ◢ ▮</span></div>
  <div id="scr"></div>
  <div id="nav"></div>
  <div id="drw"></div>
  <div id="mdl"></div>
  <div id="toast"></div>
</div>
<div class="jump" id="jump"></div>

<script>
/* ===== 1. Assets & Static Configuration ===== */
var CREST='data:image/png;base64,';
var NPH='data:image/png;base64,